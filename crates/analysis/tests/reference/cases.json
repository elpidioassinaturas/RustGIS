{
 "about": "Answers from GEOS; regenerate with `uv run generate.py` (see its header).",
 "shapely": "2.1.2",
 "geos": "3.13.1",
 "pyproj": "3.7.2",
 "proj": "9.5.1",
 "cases": [
  {
   "name": "clip polygons",
   "tool": "clip",
   "params": {
    "input": "parcels",
    "clip": "zones"
   },
   "expect": {
    "features": "expected/clip_parcels.geojson"
   }
  },
  {
   "name": "clip lines",
   "tool": "clip",
   "params": {
    "input": "roads",
    "clip": "zones"
   },
   "expect": {
    "features": "expected/clip_roads.geojson"
   }
  },
  {
   "name": "clip points",
   "tool": "clip",
   "params": {
    "input": "points",
    "clip": "zones"
   },
   "expect": {
    "ids": [
     "b",
     "d",
     "e",
     "j"
    ]
   }
  },
  {
